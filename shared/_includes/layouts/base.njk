{#- Layout base de todos los sitios del hub.
    Espera en la página: locale, pageSlug, title, description.
    El dominio sale SIEMPRE de siteConfig.origin: nunca escribirlo a mano. -#}
{%- set pageUrl = (pageSlug | localePath(locale)) | absUrl(siteConfig.origin) -%}
<!DOCTYPE html>
<html lang="{{ siteConfig.htmlLang[locale] }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }}</title>
<meta name="description" content="{{ description }}">
<link rel="canonical" href="{{ pageUrl }}">
{%- for alt in siteConfig.locales %}
<link rel="alternate" hreflang="{{ siteConfig.htmlLang[alt] }}" href="{{ (pageSlug | localePath(alt)) | absUrl(siteConfig.origin) }}">
{%- endfor %}
<link rel="alternate" hreflang="x-default" href="{{ (pageSlug | localePath(siteConfig.defaultLocale)) | absUrl(siteConfig.origin) }}">
{%- if not siteConfig.indexable %}
<meta name="robots" content="noindex, nofollow">
{%- endif %}
<meta property="og:type" content="website">
<meta property="og:site_name" content="{{ siteConfig.name | t(locale) }}">
<meta property="og:title" content="{{ title }}">
<meta property="og:description" content="{{ description }}">
<meta property="og:url" content="{{ pageUrl }}">
<meta property="og:image" content="{{ siteConfig.ogImage | absUrl(siteConfig.origin) }}">
<meta property="og:locale" content="{{ siteConfig.ogLocale[locale] }}">
<meta name="twitter:card" content="summary_large_image">
<meta name="theme-color" content="#0F223E">
<link rel="icon" type="image/png" href="/assets/img/brand/favicon.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@500;600;700&family=Roboto:wght@400;500;700&display=swap">
<link rel="stylesheet" href="{{ '/assets/css/keiser-latam.css' | assetUrl }}">
{%- if siteConfig.tracking.gtm %}
<script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer','{{ siteConfig.tracking.gtm }}');</script>
{%- endif %}
{%- if jsonLd %}
<script type="application/ld+json">{{ jsonLd | jsonScript | safe }}</script>
{%- endif %}
</head>
<body>
{%- if siteConfig.tracking.gtm %}
<noscript><iframe src="https://www.googletagmanager.com/ns.html?id={{ siteConfig.tracking.gtm }}" height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
{%- endif %}
{{ content | safe }}
{%- for script in scripts %}
<script src="{{ script | assetUrl }}" defer></script>
{%- endfor %}
</body>
</html>
