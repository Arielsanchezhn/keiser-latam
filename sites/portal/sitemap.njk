---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9" xmlns:xhtml="http://www.w3.org/1999/xhtml">
{%- for locale in siteConfig.locales %}
  <url>
    <loc>{{ ('' | localePath(locale)) | absUrl(siteConfig.origin) }}</loc>
    {%- for alt in siteConfig.locales %}
    <xhtml:link rel="alternate" hreflang="{{ siteConfig.htmlLang[alt] }}" href="{{ ('' | localePath(alt)) | absUrl(siteConfig.origin) }}"/>
    {%- endfor %}
  </url>
{%- endfor %}
</urlset>
